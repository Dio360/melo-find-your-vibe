# MELO web — copy to .env.local and adjust
# Base URL of the NestJS API (no trailing slash).
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
# In production this must be the deployed API origin, e.g.
#   NEXT_PUBLIC_API_URL="https://api.melo.app/api/v1"
# See docs/melo_deployment.md for the full deploy sequence.
# Phase 8 — session replay (optional; inert when empty)
NEXT_PUBLIC_LOGROCKET_APP_ID=""
