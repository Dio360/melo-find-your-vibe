# MELO web — copy to .env.local and adjust
# Base URL of the NestJS API (no trailing slash).
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
# In production this must be the deployed API origin, e.g.
#   NEXT_PUBLIC_API_URL="https://api.melo.app/api/v1"
# See docs/melo_deployment.md for the full deploy sequence.
# Phase 8 — session replay (optional; inert when empty)
NEXT_PUBLIC_LOGROCKET_APP_ID=""
# Stack v2 — PostHog analytics (optional; inert when empty)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# Stack v2 — Google sign-in (optional; button hidden when empty).
# Create an OAuth web client at console.cloud.google.com/apis/credentials,
# authorise the web origins, then paste the client ID here AND set the same
# value as GOOGLE_CLIENT_ID on the API.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
