# MELO server — copy to .env and adjust
PORT=3001
DATABASE_URL="postgresql://melo:melo@localhost:5432/melo"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Phase 3 — S3-compatible audio storage (local Moto S3, prod Cloudflare R2)
S3_ENDPOINT="http://localhost:5000"
S3_REGION="us-east-1"
S3_BUCKET="melo-audio"
S3_ACCESS_KEY="test"
S3_SECRET_KEY="test"
S3_FORCE_PATH_STYLE="true"
PLAYBACK_URL_TTL_SECONDS=900
# Phase 7+ — Groq LLM intent parsing (optional; falls back to rules)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
AI_PARSER="groq"
# Phase 8 — error monitoring (optional; inert when empty)
SENTRY_DSN=""
SENTRY_RELEASE=""
SENTRY_TRACES_SAMPLE_RATE="0"
